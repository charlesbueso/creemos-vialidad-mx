{
  "name": "creemos-vialidad-mx",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma 3D para soñar, trazar y evaluar transporte masivo en el Valle de México.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "analizar": "tsx scripts/analizar.ts",
    "datos:transporte": "node scripts/fetch-transit.mjs",
    "snap": "tsx scripts/snap.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright-core": "1.65.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
